# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (manual-entry DB, app-owned) ---
# Points at the dedicated Postgres server (see docs/postgres-server-setup.md)
# — there's no bundled `db` container anymore, so this must be a real,
# already-running Postgres server.
POSTGRES_HOST=192.168.x.x
POSTGRES_PORT=5432
POSTGRES_DB=trackfox
# The APP's low-privilege role. Created manually on the dedicated server
# (docs/postgres-server-setup.md Step 4) — fill in the real values, this
# name is deliberately distinct from the (now-removed) POSTGRES_USER/
# POSTGRES_PASSWORD bootstrap vars the old bundled `db` container used.
APP_DB_USER=trackfox_app
APP_DB_PASSWORD=changeme

# --- MSSQL (existing production server, read-only) ---
MSSQL_HOST=your-mssql-host
MSSQL_PORT=1433
MSSQL_DB=ProductionDB
MSSQL_USER=readonly_app_user
MSSQL_PASSWORD=changeme
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# --- App ---
APP_ENV=development
# How often the dashboard JS polls for fresh data, in milliseconds
POLL_INTERVAL_MS=60000
