# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (manual-entry DB, owned by this app) ---
# A standalone Postgres server; there is no database container in this repo.
POSTGRES_HOST=192.168.x.x
POSTGRES_PORT=5432
POSTGRES_DB=trackfox
# The app's low-privilege role, not the superuser.
APP_DB_USER=trackfox_app
APP_DB_PASSWORD=changeme

# --- MSSQL (existing production server, read-only) ---
MSSQL_HOST=your-mssql-host
MSSQL_PORT=1433
MSSQL_DB=ProductionDB
MSSQL_USER=readonly_app_user
MSSQL_PASSWORD=changeme
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# --- App ---
APP_ENV=development
# How often the dashboard polls for fresh data, in milliseconds
POLL_INTERVAL_MS=60000
