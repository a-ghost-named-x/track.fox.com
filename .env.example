# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (manual-entry DB, app-owned) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=trackfox
# This is the APP's low-privilege role (created automatically by
# sql/01_roles.sh on first container start) — NOT the Postgres superuser.
POSTGRES_USER=trackfox_app
POSTGRES_PASSWORD=changeme
# Bootstrap/superuser password, used ONLY by the postgres image on first init
# and by sql/01_roles.sh to create the role above. The app never uses this.
POSTGRES_SUPERUSER_PASSWORD=changeme_too

# --- MSSQL (existing production server, read-only) ---
MSSQL_HOST=your-mssql-host
MSSQL_PORT=1433
MSSQL_DB=ProductionDB
MSSQL_USER=readonly_app_user
MSSQL_PASSWORD=changeme
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# --- App ---
APP_ENV=development
# How often the dashboard JS polls for fresh data, in milliseconds
POLL_INTERVAL_MS=60000
