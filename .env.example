# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (manual-entry DB, app-owned) ---
# Points at the dedicated Postgres server (see docs/postgres-server-setup.md)
# — not a sibling Docker container. "db" only resolves if you're still using
# the bundled `db` service in docker-compose.yml instead of a real server.
POSTGRES_HOST=192.168.x.x
POSTGRES_PORT=5432
POSTGRES_DB=trackfox
# This is the APP's low-privilege role. On the dedicated server it's created
# manually (docs/postgres-server-setup.md Step 4) — the automatic creation
# via sql/01_roles.sh only happens for the bundled `db` container's
# first-boot init, which this setup no longer relies on.
POSTGRES_USER=trackfox_app
POSTGRES_PASSWORD=changeme
# Bootstrap/superuser password — only relevant if you're still running the
# local `db` service from docker-compose.yml; unused against a real server.
POSTGRES_SUPERUSER_PASSWORD=changeme_too

# --- MSSQL (existing production server, read-only) ---
MSSQL_HOST=your-mssql-host
MSSQL_PORT=1433
MSSQL_DB=ProductionDB
MSSQL_USER=readonly_app_user
MSSQL_PASSWORD=changeme
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# --- App ---
APP_ENV=development
# How often the dashboard JS polls for fresh data, in milliseconds
POLL_INTERVAL_MS=60000
