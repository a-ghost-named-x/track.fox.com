# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
# A standalone Postgres server; there is no database container in this repo.
POSTGRES_HOST=192.168.x.x
POSTGRES_PORT=5432
POSTGRES_DB=trackfox
# The app's low-privilege role, not the superuser.
APP_DB_USER=trackfox_app
APP_DB_PASSWORD=changeme

# --- App ---
APP_ENV=development
# How often the dashboard polls for fresh data, in milliseconds
POLL_INTERVAL_MS=60000
